# DRAFT, not active (GitHub ignores this file because of its name).
# To turn it on after review, rename it to infra.yml.
#
# Checks the Terraform in infra/ on pull requests that touch it. It needs no AWS
# credentials: nothing is planned or applied against an account.
name: infra
on:
  pull_request:
    paths:
      - 'infra/**'
      - 'index.html' # the static-site CSP header mirrors the meta tag
      - '.github/workflows/infra.yml'

permissions:
  contents: read

concurrency:
  group: infra-${{ github.ref }}
  cancel-in-progress: true

jobs:
  terraform:
    runs-on: ubuntu-24.04
    defaults:
      run:
        working-directory: infra
    steps:
      - uses: actions/checkout@v4
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: '1.9.8'
          terraform_wrapper: false
      - name: Format
        run: terraform fmt -check -recursive -diff
      - name: Init (no backend, no credentials)
        run: terraform init -backend=false -input=false
      - name: Validate
        run: terraform validate -no-color
      # Mocked provider, so no account is needed. Written and passing under OpenTofu 1.8;
      # not yet run under Terraform, so review the first result before making it required.
      - name: Plan-level tests
        run: terraform test -no-color
      - name: CSP header matches index.html
        run: sh scripts/check-csp.sh

  lint:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - uses: terraform-linters/setup-tflint@v4
      - name: tflint
        working-directory: infra
        run: |
          tflint --init --config "$PWD/.tflint.hcl"
          tflint --recursive --config "$PWD/.tflint.hcl"
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: checkov
        working-directory: infra
        run: |
          pip install --quiet checkov
          checkov -d . --config-file .checkov.yaml
